{
  "name": "ffclaw",
  "version": "0.1.0",
  "description": "CLI video editor powered by FFCreator — the command-line剪映",
  "type": "module",
  "bin": {
    "ffclaw": "./bin/ffclaw.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest test/unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest test/integration",
    "lint": "eslint src bin --ext .js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "cross-spawn": "^7.0.6",
    "ffcreator": "file:./vendor/FFCreator",
    "get-pixels": "^3.3.3",
    "gl": "^8.1.6",
    "gl-texture2d": "^2.1.0",
    "gl-transition": "^1.13.0",
    "gl-transition-utils": "^1.18.0",
    "ndarray": "^1.0.19",
    "psl": "^1.15.0",
    "request": "^2.88.2",
    "save-pixels": "^2.3.6",
    "write-file-atomic": "^5.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/vendor/"
    ]
  },
  "keywords": [
    "video",
    "cli",
    "ffcreator",
    "ffmpeg",
    "editor"
  ],
  "license": "MIT"
}

{
  "name": "ffclaw",
  "version": "0.1.0",
  "description": "CLI video editor powered by FFmpeg — the command-line video tool",
  "type": "module",
  "bin": {
    "ffclaw": "./bin/ffclaw.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest test/unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest test/integration",
    "lint": "eslint src bin --ext .js"
  },
  "dependencies": {
    "get-pixels": "^3.3.3",
    "gl": "^8.1.6",
    "gl-texture2d": "^2.1.0",
    "gl-transition": "^1.13.0",
    "ndarray": "^1.0.19",
    "save-pixels": "^2.3.6",
    "write-file-atomic": "^5.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/vendor/"
    ]
  },
  "keywords": [
    "video",
    "cli",
    "ffmpeg",
    "editor"
  ],
  "license": "MIT"
}
